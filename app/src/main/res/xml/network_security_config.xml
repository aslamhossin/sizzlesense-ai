<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permits HTTP to user-configured LAN IPs (192.168.x.x) for local FastAPI & Tapo C100 RTSP -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
